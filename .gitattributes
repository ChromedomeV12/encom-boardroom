# Normalize line endings to LF in the repository.
# Working-tree checkout also uses LF so WSL2/Windows editors stop producing
# phantom CRLF-only diffs against the ENCOM boardroom source.
* text=auto eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
*.svg binary
*.ico binary
